# Chave de um projeto Google Cloud com Google Drive API ativada.
# Usar somente pastas/imagens públicas. Nunca colocar a chave no JavaScript do site.
GOOGLE_DRIVE_API_KEY=

# Caminho do arquivo JSON da conta de serviço. Nunca publique esse arquivo.
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/blackvis-drive.json

# Compatibilidade com ambientes que usam o nome padrão do Google.
GOOGLE_APPLICATION_CREDENTIALS=
TECHNIQUES_DRIVE_FOLDER_ID=

# Pasta "Adinkra / Ver. 2O26 (mɐteus) / vetores"; opcional se usar o ID padrão no servidor.
ADINKRA_DRIVE_FOLDER_ID=
HOME_ADINKRA_DRIVE_FOLDER_ID=
WORKS_PORT=5501

# Ative somente quando a galeria de obras estiver pronta para publicação.
WORKS_ENABLED=false

# Caminho local do cadastro privado. Em produção, use o caminho do arquivo secreto.
DESIGNERS_DATA_FILE=secrets/designers.json

# Separe múltiplas origens por vírgula quando a interface estiver publicada.
WORKS_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
